# Copy to .env and fill in. Never commit real secrets.

# ---------- Web (Vite) ----------
VITE_API_URL=http://localhost:4000

# ---------- API ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
PUBLIC_API_URL=http://localhost:4000
WEB_APP_URL=http://localhost:5173
# Comma-separated origins allowed to call the API with cookies (lock down in production).
CORS_ORIGINS=http://localhost:5173
# Defaults to true in production. Keep true behind HTTPS.
# COOKIE_SECURE=true
SESSION_TTL_HOURS=168
ALLOW_PUBLIC_SIGNUP=false

# Control-plane DB the API uses at runtime (created by `npm run migrate`).
CONTROL_DATABASE_URL=postgres://sb_api:CHANGE_ME@localhost:5433/sb_control
# Admin connection used ONLY to create tenant databases/roles and the control DB.
# In production use a role with CREATEDB and CREATEROLE, not a superuser.
PG_ADMIN_URL=postgres://sb_admin:sb_admin_dev_password@localhost:5433/postgres
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5433
TENANT_DB_PREFIX=sb_t_
TENANT_POOL_MAX_OPEN=50
TENANT_POOL_SIZE=5
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TENANT_SECRETS_KEY=

# console = development only (messages are logged). Production requires smtp / kavenegar.
EMAIL_PROVIDER=console
SMTP_URL=
EMAIL_FROM=Site Builder <no-reply@example.com>
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=

# local = files on disk served by the API (development). s3 = any S3-compatible service.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/uploads
STORAGE_SIGNING_KEY=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=
UPLOAD_MAX_BYTES=10485760

# ---------- Local development accounts (npm run seed; never in production) ----------
DEV_ADMIN_EMAIL=admin@site-builder.localhost
DEV_ADMIN_PASSWORD=
DEV_OWNER_EMAIL=owner@ateliernavar.localhost
DEV_OWNER_PASSWORD=
