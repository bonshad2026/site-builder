# Copy to deploy/.env. Never commit real secrets.
CONTROL_ADMIN_EMAIL=you@example.com
CONTROL_ADMIN_PASSWORD=
# 32+ random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTROL_SESSION_SECRET=
# Optional: install the locked npm packages from this registry instead (e.g. https://registry.npmjs.org/)
NPM_REGISTRY=

# Folder for site exports (host path)
EXPORT_DIR=../exports

# Studio (where all sites are built); generate each with 32 random bytes
STUDIO_DB_PASSWORD=
STUDIO_API_DB_PASSWORD=
STUDIO_TENANT_SECRETS_KEY=
STUDIO_STORAGE_SIGNING_KEY=

# Optional: sign-in on clients' servers for new packages (else generated per site)
SITE_OPERATOR_LOGIN=
SITE_OPERATOR_PASSWORD=
SITE_OWNER_LOGIN=
SITE_OWNER_PASSWORD=
