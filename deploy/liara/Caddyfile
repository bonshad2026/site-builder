# Liara terminates HTTPS and forwards plain HTTP to port 80; the API runs in the same container.
{
	admin off
}
:80 {
	encode gzip
	handle /api/* {
		reverse_proxy 127.0.0.1:4000
	}
	handle /files/* {
		reverse_proxy 127.0.0.1:4000
	}
	# The sitemap is made live by the API, so products and pages added on this server are in it.
	handle /sitemap.xml {
		rewrite * /api/v1/public/sites/{$CELL_SLUG}/sitemap.xml
		reverse_proxy 127.0.0.1:4000
	}
	handle {
		root * /srv/site
		try_files {path} {path}/index.html /index.html
		file_server
	}
}
