# Liara terminates HTTPS and forwards plain HTTP to port 80; the API runs in the same container.
{
	admin off
}
:80 {
    # Keep APK rejection before all proxy/static handlers.
    route {
	encode gzip
    # APKs are available only through the authenticated owner download endpoint.
    @publicApk path_regexp publicApk (?i)\.apk$
    respond @publicApk 404
	handle /api/* {
		reverse_proxy 127.0.0.1:4000 {
			header_up X-Forwarded-Proto https
		}
	}
	handle /files/* {
		reverse_proxy 127.0.0.1:4000 {
			header_up X-Forwarded-Proto https
		}
	}
	# The sitemap is made live by the API, so products and pages added on this server are in it.
	@verification path_regexp verification ^/[0-9]{1,30}\.txt$
	handle @verification {
	    rewrite * /api/v1/public/sites/{$CELL_SLUG}/verification-files{path}
	    reverse_proxy 127.0.0.1:4000
	}
	handle /sitemap.xml {
		rewrite * /api/v1/public/sites/{$CELL_SLUG}/sitemap.xml
		reverse_proxy 127.0.0.1:4000 {
			header_up X-Forwarded-Proto https
		}
	}
	handle {
		root * /tmp/site
		try_files {path} {path}/index.html /index.html
		file_server
	}
    }
}
