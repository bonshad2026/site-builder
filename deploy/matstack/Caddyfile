:80 {
    encode gzip
    @private path /admin /admin/* /api/v1/auth/* /api/v1/platform/* /api/v1/sites/*
    handle @private {
        respond "Not found" 404
    }
    handle /api/* {
        reverse_proxy api:4000 {
            header_up X-Forwarded-Proto https
        }
    }
    handle /files/* {
        reverse_proxy api:4000
    }
    handle /sitemap.xml {
        rewrite * /api/v1/public/sites/{$CELL_SLUG}/sitemap.xml
        reverse_proxy api:4000
    }
    handle {
        root * /srv/site
        try_files {path} {path}/index.html /index.html
        file_server
    }
}

# Owner panel is exposed only through the loopback-only :8727 mapping.
:81 {
    encode gzip
    handle /api/* {
        reverse_proxy api:4000 {
            header_up X-Forwarded-Proto https
        }
    }
    handle /files/* {
        reverse_proxy api:4000
    }
    handle {
        root * /srv/site
        try_files {path} {path}/index.html /index.html
        file_server
    }
}
